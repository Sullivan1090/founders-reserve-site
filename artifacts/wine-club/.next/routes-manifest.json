{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/members/releases/[slug]",
      "regex": "^/members/releases/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/members/releases/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/members/tasting-notes/[wine]",
      "regex": "^/members/tasting\\-notes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPwine": "nxtPwine"
      },
      "namedRegex": "^/members/tasting\\-notes/(?<nxtPwine>[^/]+?)(?:/)?$"
    },
    {
      "page": "/members/tasting-notes/[wine]/[year]",
      "regex": "^/members/tasting\\-notes/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPwine": "nxtPwine",
        "nxtPyear": "nxtPyear"
      },
      "namedRegex": "^/members/tasting\\-notes/(?<nxtPwine>[^/]+?)/(?<nxtPyear>[^/]+?)(?:/)?$"
    },
    {
      "page": "/members/videos/[id]",
      "regex": "^/members/videos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/members/videos/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/share/[token]",
      "regex": "^/share/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/share/(?<nxtPtoken>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
